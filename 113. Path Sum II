# Definition for a binary tree node.
# class TreeNode:
#     def __init__(self, val=0, left=None, right=None):
#         self.val = val
#         self.left = left
#         self.right = right
# Solution 1: DFS
class Solution:
    def pathSum(self, root: Optional[TreeNode], targetSum: int) -> List[List[int]]:
        if not root:
            return []

        res=[]
        def hit_target(node,remain,path):
            path.append(node.val)
            if not node.left and not node.right and node.val==remain:
                res.append(path[:])
            remain-=node.val
            if node.left:
                hit_target(node.left,remain,path)
            if node.right:
                hit_target(node.right,remain,path)
            path.pop()

        hit_target(root,targetSum,[]) 
        return res

# Solution 2: BFS
class Solution:
    def pathSum(self, root: Optional[TreeNode], targetSum: int) -> List[List[int]]:
        if not root:
            return []
        
        res=[]
        queue=deque([(root,[],targetSum)])
        while queue:
            cur,path,remain=queue.popleft()
            path.append(cur.val)
            if not cur.left and not cur.right and cur.val==remain:
                res.append(path)
            remain-=cur.val
            if cur.left:
                queue.append((cur.left,path,remain))

            if cur.right:
                queue.append((cur.right,path,remain))
        return res
