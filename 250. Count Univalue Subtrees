def num_univalue_tree(root):
    if not root:
        return 0
    
    count=0

    def is_unival_tree(node):
        nonlocal count

        if not node:
            return True
        
        is_left_unival=is_unival_tree(node.left)
        is_right_unival=is_unival_tree(node.right)
        
        if not is_left_unival or not is_right_unival:
            return False
        if node.left and node.val!=node.left.val:
            return False
        if node.right and node.val!=node.right.val:
            return False
        
        count+=1
        return True

    is_unival_tree(root)
    return count
